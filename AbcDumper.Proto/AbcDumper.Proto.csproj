<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <DefaultItemExcludesInProjectFolder>$(DefaultItemExcludesInProjectFolder);obj/**;Build/bin/**;Build/obj/**</DefaultItemExcludesInProjectFolder>
    <ProtoGeneratorDirectory>../AbcDumper.Proto.Build</ProtoGeneratorDirectory>
    <ProtoOptions>$(ProtoGeneratorDirectory)/abc_options.proto</ProtoOptions>
    <GeneratedProto>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', '$(Configuration)', '$(TargetFramework)', 'Proto', 'dump.g.cs'))</GeneratedProto>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Abc.Bin.Serialization/Abc.Bin.Serialization.csproj" />
    <ProjectReference Include="$(ProtoGeneratorDirectory)/AbcDumper.Proto.Build.csproj" ReferenceOutputAssembly="false" OutputItemType="ProtoGenerator" Private="false" PrivateAssets="all" />
    <UpToDateCheckInput Include="dump.proto;NameTranslation.txt;$(ProtoOptions)" />
    <UpToDateCheckInput Include="$(ProtoGeneratorDirectory)/**/*.cs;$(ProtoGeneratorDirectory)/AbcDumper.Proto.Build.csproj" Exclude="$(ProtoGeneratorDirectory)/bin/**;$(ProtoGeneratorDirectory)/obj/**" />
    <UpToDateCheckBuilt Include="$(GeneratedProto)" />
  </ItemGroup>

  <Target Name="GenerateAbcProto"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="dump.proto;NameTranslation.txt;$(ProtoOptions);@(ProtoGenerator);$(MSBuildProjectFullPath)"
          Outputs="$(GeneratedProto)">
    <Exec Command='dotnet &quot;@(ProtoGenerator)&quot; dump.proto NameTranslation.txt &quot;$(ProtoOptions)&quot; &quot;$(GeneratedProto)&quot;' />
    <ItemGroup><FileWrites Include="$(GeneratedProto)" /></ItemGroup>
  </Target>

  <Target Name="IncludeGeneratedAbcProto" BeforeTargets="CoreCompile" DependsOnTargets="GenerateAbcProto">
    <ItemGroup Condition="Exists('$(GeneratedProto)')">
      <Compile Include="$(GeneratedProto)" AutoGen="true" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
